# Auto detect text files and perform LF normalization
* text=auto

# Source code files with LF line endings
*.kt text eol=lf
*.kts text eol=lf
*.java text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.pro text eol=lf
*.properties text eol=lf
*.gradle text eol=lf

# Shell scripts must always use LF
*.sh text eol=lf
gradlew text eol=lf

# Windows batch scripts must use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.aar binary
*.apk binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.svg text
*.ico binary
